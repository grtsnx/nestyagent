// The app's database. Run `bun run db:migrate` after you change it.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// Approval ids use UUIDv7; worker ownership tokens use random UUIDs.
// Ids from outside (chat ids you pick, OpenAI session and environment ids) stay text.
// Every time is stored with its time zone (timestamptz).

// One chat. Deleting it deletes its items.
model Chat {
  id                String                 @id
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  items             ChatItem[]
  historyOperations ChatHistoryOperation[]

  @@map("chats")
}

// Deduplicates SDK history writes in the same transaction as their items.
model ChatHistoryOperation {
  chatId      String   @map("chat_id")
  operationId String   @map("operation_id")
  digest      String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  chat        Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([chatId, operationId])
  @@map("chat_history_operations")
}

// One message or tool step in a chat.
// The id is a counter, not a UUID: it keeps items in the exact order they were added.
model ChatItem {
  id        BigInt   @id @default(autoincrement())
  chatId    String   @map("chat_id")
  item      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  // Reads, limits, and pops all ask for one chat's items by id.
  @@index([chatId, id])
  @@map("chat_items")
}

enum PausedRunStatus {
  waiting
  taken
  running
  completed
  recovery_required
}

// A versioned approval checkpoint. Interrupted execution requires reconciliation.
model PausedRun {
  id           String          @id @default(uuid(7)) @db.Uuid
  state        String
  status       PausedRunStatus @default(waiting)
  version      Int             @default(0)
  chatId       String?         @map("chat_id")
  agentName    String?         @map("agent_name")
  agentVersion String?         @map("agent_version")
  ownerId      String?         @map("owner_id")
  runOptions   Json?           @map("run_options")
  recoveryNote String?         @map("recovery_note")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("paused_runs")
}

// The machine a self-hosted session runs on. One row per session.
// claimToken marks which webhook owns the create. machineId is set once the machine exists.
model RemoteMachine {
  sessionId     String                    @id @map("session_id")
  environmentId String                    @unique @map("environment_id")
  claimToken    String                    @map("claim_token") @db.Uuid
  claimedAt     DateTime                  @default(now()) @map("claimed_at") @db.Timestamptz(3)
  machineId     String?                   @map("machine_id")
  provider      String?
  status        RemoteMachineStatus       @default(pending)
  desiredState  RemoteMachineDesiredState @default(active) @map("desired_state")
  lastError     String?                   @map("last_error")
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("remote_machines")
}

enum RemoteMachineStatus {
  pending
  creating
  ready
  reconciliation
  deleted
}

enum RemoteMachineDesiredState {
  active
  deleted
}

enum HostedWebhookStatus {
  pending
  processing
  completed
  reconciliation
}

model HostedWebhook {
  id             String              @id
  type           String
  resourceId     String              @map("resource_id")
  status         HostedWebhookStatus @default(pending)
  attempts       Int                 @default(0)
  availableAt    DateTime            @default(now()) @map("available_at") @db.Timestamptz(3)
  leaseToken     String?             @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime?           @map("lease_expires_at") @db.Timestamptz(3)
  lastError      String?             @map("last_error")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@index([type, resourceId])
  @@map("hosted_webhooks")
}

// A lock held by one worker. The owner renews expiresAt; a crashed owner's lock frees itself.
model ExecutionLock {
  key       String   @id
  owner     String   @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([owner])
  @@map("execution_locks")
}

// An environment OpenAI reported as expired. Expiry is permanent, so a late event never revives it.
model ExpiredEnvironment {
  environmentId String   @id @map("environment_id")
  expiredAt     DateTime @default(now()) @map("expired_at") @db.Timestamptz(3)

  @@map("expired_environments")
}

// A helper's system prompt, edited through the API. Without a row, the default file in
// src/config/system-prompts is used. version guards against two people editing at once.
model SystemPrompt {
  name      String   @id
  content   String
  version   Int      @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_prompts")
}

// One Composio session per user, kept on the server. Callers never pass a session id,
// so one user can never open another user's connected apps.
model ComposioSession {
  userId    String   @id @map("user_id")
  sessionId String   @unique @map("session_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("composio_sessions")
}

enum AgentRunStatus {
  completed
  waiting
  failed
}

// One helper run, for the admin monitoring routes: tokens, time, result, and its trace.
// It holds no message text, only numbers and ids.
model AgentRun {
  id           String         @id @default(uuid(7)) @db.Uuid
  chatId       String?        @map("chat_id")
  agent        String
  model        String?
  userId       String?        @map("user_id")
  status       AgentRunStatus
  error        String?
  requests     Int            @default(0)
  inputTokens  Int            @default(0) @map("input_tokens")
  outputTokens Int            @default(0) @map("output_tokens")
  cachedTokens Int            @default(0) @map("cached_tokens")
  durationMs   Int            @map("duration_ms")
  traceId      String?        @map("trace_id")
  requestId    String?        @map("request_id")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  // Usage by day and recent runs read by time; one chat's runs read by chat.
  @@index([createdAt])
  @@index([chatId, createdAt])
  @@map("agent_runs")
}

// A ChatKit conversation. data holds ChatKit's own thread shape as JSON, so a ChatKit
// update needs no migration. Every row belongs to one user, and every query checks it.
model ChatkitThread {
  id          String              @id
  userId      String              @map("user_id")
  data        Json
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  items       ChatkitItem[]
  attachments ChatkitAttachment[]

  // A user's threads, newest first.
  @@index([userId, createdAt])
  @@map("chatkit_threads")
}

// One ChatKit thread item as JSON. seq keeps items in the exact order they were added.
model ChatkitItem {
  threadId  String        @map("thread_id")
  id        String
  seq       BigInt        @default(autoincrement())
  data      Json
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  thread    ChatkitThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@id([threadId, id])
  // A thread's items in order, for paging both ways.
  @@index([threadId, seq])
  @@map("chatkit_items")
}

// An uploaded file. content holds the bytes until the attachment or its thread is deleted.
model ChatkitAttachment {
  id        String         @id
  userId    String         @map("user_id")
  threadId  String?        @map("thread_id")
  data      Json
  content   Bytes?
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  thread    ChatkitThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([threadId])
  @@map("chatkit_attachments")
}

enum ChatkitFeedbackKind {
  positive
  negative
}

// Thumbs up or down from the ChatKit window, for evals.
model ChatkitFeedback {
  id        String              @id @default(uuid(7)) @db.Uuid
  userId    String              @map("user_id")
  threadId  String              @map("thread_id")
  itemIds   String[]            @map("item_ids")
  kind      ChatkitFeedbackKind
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([threadId])
  @@index([createdAt])
  @@map("chatkit_feedback")
}
