// The app's database. Run `bun run db:migrate` after you change it.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// Ids we create are UUIDv7: time ordered, so new rows land at the end of the index.
// Ids from outside (chat ids you pick, OpenAI session and environment ids) stay text.
// Every time is stored with its time zone (timestamptz).

// One chat. Deleting it deletes its items.
model Chat {
  id        String     @id
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  items     ChatItem[]

  @@map("chats")
}

// One message or tool step in a chat.
// The id is a counter, not a UUID: it keeps items in the exact order they were added.
model ChatItem {
  id        BigInt   @id @default(autoincrement())
  chatId    String   @map("chat_id")
  item      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  // Reads, limits, and pops all ask for one chat's items by id.
  @@index([chatId, id])
  @@map("chat_items")
}

enum PausedRunStatus {
  waiting
  taken
}

// A run that stopped for a person to approve. It can be taken once.
model PausedRun {
  id        String          @id @default(uuid(7)) @db.Uuid
  state     String
  status    PausedRunStatus @default(waiting)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("paused_runs")
}

// The machine a self-hosted session runs on. One row per session.
// claimToken marks which webhook owns the create. machineId is set once the machine exists.
model RemoteMachine {
  sessionId     String   @id @map("session_id")
  environmentId String   @unique @map("environment_id")
  claimToken    String   @map("claim_token") @db.Uuid
  claimedAt     DateTime @default(now()) @map("claimed_at") @db.Timestamptz(3)
  machineId     String?  @map("machine_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("remote_machines")
}
