{
  "name": "agentic",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "multer": "2.5.0",
    "zod": "4.6.7",
    "js-yaml": "5.5.0"
  },
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{ts,json,md}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{ts,json,md}\" \".github/**/*.{yml,yaml}\"",
    "start": "nest start --env-file .env",
    "start:dev": "nest start --watch --env-file .env",
    "start:debug": "nest start --debug --watch --env-file .env",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:cov": "NODE_ENV=test vitest run --coverage",
    "test:debug": "NODE_ENV=test vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "NODE_ENV=test vitest run --config ./vitest.config.e2e.ts",
    "test:integration": "NODE_ENV=test vitest run --config ./vitest.config.integration.ts"
  },
  "dependencies": {
    "@blaxel/core": "^0.3.32",
    "@daytonaio/sdk": "^0.226.1",
    "@langfuse/otel": "^6.0.2",
    "@langfuse/tracing": "^6.0.2",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/observe": "^0.3.17",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@openai/agents": "^0.21.0",
    "@openai/agents-extensions": "0.21.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/otlp-exporter-base": "^0.300.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@scalar/nestjs-api-reference": "^1.2.31",
    "@vercel/sandbox": "^3.9.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "e2b": "^2.61.0",
    "modal": "^0.11.1",
    "openai": "^7.45.0",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsc-alias": "^1.9.9",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
