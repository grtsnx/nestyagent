NODE_ENV=development
PORT=3000
PLATFORM_NAME=Agentic

# Exact comma-separated origins. Leave empty to disable cross-origin access.
CORS_ORIGINS=http://localhost:3000

# Swagger defaults to enabled outside production and disabled in production.
SWAGGER_ENABLED=true

# Observability is opt-in. Supply all credentials when enabling it.
OBSERVE_ENABLED=false
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=

# Shared by every OpenAI agent. Leave empty to boot without it.
OPENAI_API_KEY=

# One login secret for every workspace. Leave empty to start without it.
ACCOUNT_PASSWORD=

# Restricted key for codex exec-server. Leave empty until you start a self-hosted executor.
OPENAI_EXECUTOR_API_KEY=

# Signing secret from the OpenAI webhook endpoint. Leave empty until you register /v1/sandbox/hosted-webhook.
OPENAI_WEBHOOK_SECRET=

# local starts the executor on this Mac. aws, digitalocean, databricks, or oci creates that machine instead.
REMOTE_MACHINE_PROVIDER=local

# AWS Lambda MicroVM. Required only when REMOTE_MACHINE_PROVIDER=aws.
AWS_MICROVM_IMAGE_ARN=
AWS_MICROVM_EXECUTION_ROLE=
AWS_MICROVM_SECRET_ARN=
AWS_REGION=

# DigitalOcean token. Required only when REMOTE_MACHINE_PROVIDER=digitalocean.
DIGITALOCEAN_TOKEN=

# Databricks workspace. DATABRICKS_HOST is the https workspace URL.
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# OCI. OCI_SANDBOX_CREATE_URL is the current create URL from the OCI sandbox guide.
OCI_SANDBOX_PROJECT_ID=
OCI_SANDBOX_TOKEN=
OCI_SANDBOX_CREATE_URL=

# Cloudflare sandbox worker. Required only when computer is cloudflare and workerUrl is not passed.
CLOUDFLARE_SANDBOX_WORKER_URL=
CLOUDFLARE_SANDBOX_API_KEY=
